% reader.sty — print layout for the annotated vocabulary reader (XeLaTeX, A5, two-sided)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reader}[2026/10/03]

\RequirePackage[a5paper,top=11mm,bottom=14mm,inner=15mm,outer=11mm,headheight=0pt,headsep=0pt,
  footskip=7.5mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage[CJKmath=true]{xeCJK}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{fancyhdr}
\RequirePackage{amssymb}
\RequirePackage{etoolbox}
\RequirePackage{multicol}
\RequirePackage[most]{tcolorbox}

% ---------- fonts ----------
\def\FP{fonts/}
\setmainfont{Literata}[Path=\FP, Extension=.ttf, UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic]
\newfontfamily\titlefont{Literata}[Path=\FP, Extension=.ttf, UprightFont=*-Bold, ItalicFont=*-Italic]
\newfontfamily\ipafont{Charis}[Path=\FP, Extension=.ttf, UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-Bold]
\newfontfamily\labelfont{SourceSans3}[Path=\FP, Extension=.otf, UprightFont=*-Regular, ItalicFont=*-It,
  BoldFont=*-Semibold]
\setCJKmainfont{SourceHanSerifSC}[Path=\FP, Extension=.otf, UprightFont=*-Regular, BoldFont=*-SemiBold]
\setCJKsansfont{SourceHanSansSC}[Path=\FP, Extension=.otf, UprightFont=*-Regular, BoldFont=*-Medium]
\newCJKfontfamily\kai{LXGWWenKai}[Path=\FP, Extension=.ttf, UprightFont=*-Regular, BoldFont=*-Medium]
\newCJKfontfamily\cjkheavy{SourceHanSerifSC}[Path=\FP, Extension=.otf, UprightFont=*-Heavy]
\newCJKfontfamily\cjksemi{SourceHanSerifSC}[Path=\FP, Extension=.otf, UprightFont=*-SemiBold]
\newCJKfontfamily\cjksans{SourceHanSansSC}[Path=\FP, Extension=.otf, UprightFont=*-Regular, BoldFont=*-Medium]
\xeCJKsetup{CJKecglue={\hskip 0.12em plus 0.05em}}
\xeCJKDeclareCharClass{Default}{"2018,"2019,"201C,"201D,"2014,"2013,"2026}

% ---------- colours (chosen to survive grey-scale and colour printing) ----------
\definecolor{teal}{HTML}{1F5A66}
\definecolor{tealtext}{HTML}{1E6573}
\definecolor{orange}{HTML}{B5501F}
\definecolor{cream}{HTML}{F7F1E6}
\definecolor{greytext}{HTML}{6E6E6E}
\definecolor{greyline}{HTML}{A6A6A6}
\definecolor{review}{HTML}{B03A2E}
\definecolor{segA}{HTML}{B5501F}
\definecolor{segB}{HTML}{1E6573}
\definecolor{segC}{HTML}{6A3F94}
\definecolor{segD}{HTML}{4F7A16}
\definecolor{yibg}{HTML}{EEF4F5}
\definecolor{gbg}{HTML}{FBF0E7}

% ---------- page style ----------
\newcommand\booktitle{Read to Remember}
\newcommand\lessonfoot{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\newcommand\footpage{{\labelfont\bfseries\small\color{greytext}\thepage}}
\newcommand\footsep{\enspace{\color{greyline}|}\enspace}
\newcommand\setfooter{\fancyhf{}%
  \fancyfoot[LE]{\footpage\footsep{\labelfont\footnotesize\itshape\color{greytext}\booktitle}}%
  \fancyfoot[RO]{{\labelfont\footnotesize\color{greytext}\lessonfoot}\ifdefempty\lessonfoot{}{\footsep}\footpage}}
\setfooter
\setlength\parindent{0pt}
\setlength\parskip{0pt}
\sloppy
\emergencystretch=2em

% ---------- interlinear annotation ----------
% a cell: row 1 = the word (sets the baseline); rows below = annotation lines; all centred
% the word row uses an em-relative strut; each annotation row is padded left/right so that notes of
% neighbouring words always keep a visible gap
\newcommand\cellstrut{\vrule height .76em depth .26em width 0pt}
\newcommand\cell[2]{\leavevmode\vtop{\offinterlineskip\halign{\hfil##\hfil\cr\cellstrut#1\cr\noalign{\kern0.9pt}#2\cr}}}
\newcommand\annline[1]{\hbox{\kern1.3pt{\vrule height 6.7pt depth 1.9pt width 0pt#1}\kern1.3pt}}
\newcommand\ipa[1]{{\ipafont\fontsize{7.2}{8}\selectfont\color{greytext}#1}}
\newcommand\pos[1]{{\labelfont\itshape\fontsize{7.2}{8}\selectfont\color{tealtext}#1}}
\newcommand\zh[1]{{\kai\fontsize{7.8}{8}\selectfont\color{tealtext}#1}}
\newcommand\zhgrey[1]{{\kai\fontsize{7.8}{8}\selectfont\color{greytext}#1}}
\newcommand\baseform[1]{{\labelfont\fontsize{7.6}{8}\selectfont\color{tealtext}#1}}

\newlength\ulpos \setlength\ulpos{-2.2pt}
\newcommand\ulsolid[2][teal]{\setbox0\hbox{#2}\rlap{\color{#1}\rule[\ulpos]{\wd0}{0.5pt}}\box0\relax}
\newcommand\uldotted[2][teal]{\setbox0\hbox{#2}\rlap{\raisebox{\ulpos}[0pt][0pt]{\color{#1}%
  \hbox to\wd0{\leaders\hbox to 1.6pt{\hss\rule{0.6pt}{0.6pt}\hss}\hfill}}}\box0\relax}
\newcommand\uldashed[2][review]{\setbox0\hbox{#2}\rlap{\raisebox{\ulpos}[0pt][0pt]{\color{#1}%
  \hbox to\wd0{\leaders\hbox to 2.8pt{\rule{1.7pt}{0.5pt}\hss}\hfill}}}\box0\relax}

\newcommand\NW[6]{\cell{#1\ulsolid{#2}#3}{\annline{\ipa{#4}}\cr\annline{\pos{#5}\,\zh{#6}}}}
\newcommand\NWB[7]{\cell{#1\ulsolid{#2}#3}{\annline{\baseform{#4}\,\ipa{#5}}\cr\annline{\pos{#6}\,\zh{#7}}}}
% new sense of a known word: \NS{pre}{word}{post}{tag}{base or empty}{ipa}{pos}{zh}; tag is 新义 or 新词性
\newcommand\nstag[1]{{\cjksans\bfseries\fontsize{7.6}{8}\selectfont\color{orange}#1}}
\newcommand\NS[8]{\cell{#1\ulsolid{#2}#3}{\annline{\nstag{#4}\,\ifstrempty{#5}{}{\baseform{#5}\,}\ipa{#6}}\cr\annline{\pos{#7}\,\zh{#8}}}}
\newcommand\AG[3]{\leavevmode#1\uldotted{#2}#3}
\newcommand\AGB[4]{\cell{#1\uldotted{#2}#3}{\annline{\baseform{#4}}}}
\newcommand\RV[3]{\leavevmode#1\uldashed{#2}#3}
\newcommand\RVB[4]{\cell{#1\uldashed{#2}#3}{\annline{\baseform{#4}}}}
\newcommand\posgrey[1]{{\labelfont\itshape\fontsize{7.2}{8}\selectfont\color{greytext}#1}}
% \PN{pre}{name}{post}{ipa}{pos}{zh}: grey; ipa line only when given (Chinese pinyin names have none)
\newcommand\PN[6]{\cell{#1\ulsolid[greyline]{#2}#3}{\ifstrempty{#4}{}{\annline{\ipa{#4}}\cr}\annline{\posgrey{#5}\,\zhgrey{#6}}}}
\newcommand\GL[6]{\cell{#1\ulsolid[greyline]{#2}#3}{\ifstrempty{#4}{}{\annline{\ipa{#4}}\cr}\annline{\posgrey{#5}\,\zhgrey{#6}}}}
\newcommand\DV[6]{\cell{#1\ulsolid{#2}#3}{\annline{\baseform{#4}}\cr\annline{\pos{#5}\,\zh{#6}}}}

\newlength\phw
\newcommand\bracketrule[1]{\hbox to #1{\vrule height 2.2pt depth 0pt width 0.45pt\leaders\hrule height 0.45pt\hfill\vrule height 2.2pt depth 0pt width 0.45pt}}
\newcommand\PH[3]{\leavevmode\setbox2\hbox{#1}\setlength\phw{\wd2}\vtop{\offinterlineskip\halign{\hfil##\hfil\cr\box2\cr\noalign{\kern1pt}%
  {\color{tealtext}\bracketrule{\phw}}\cr\noalign{\kern0.5pt}%
  \annline{\baseform{#2}\,\zh{#3}}\cr}}}

% ---------- body ----------
% a line of words with two annotation rows: word height ~7.8pt, depth below baseline ~22pt; the
% baselineskip covers both, lineskip keeps >= 1.5pt clear if a taller construction occurs
\newenvironment{lessonbody}{\par\fontsize{10.2}{12}\selectfont
  \setlength\baselineskip{28.5pt}\setlength\lineskiplimit{1.5pt}\setlength\lineskip{1.5pt}%
  \setlength\parskip{1pt}\spaceskip=0.33em plus 0.5em minus 0.02em\relax}{\par}

% paragraph start: number in the margin, first-line indent, extra space before
\newcommand\PARA[1]{\par\vspace{1.5pt}\noindent\llap{{\labelfont\bfseries\fontsize{8}{8}\selectfont\color{tealtext!70}#1}\hspace{3mm}}\hspace*{1.2em}}
% ---------- notes: tinted boxes, sans/kai, clearly not body text ----------
% sentence markers: corner brackets around the sentence a note talks about, number at the end
\def\mkcoly{tealtext}\def\mkcolg{orange}
\newcommand\markcolor[1]{\csname mkcol#1\endcsname}
\newcommand\SMK[1]{\leavevmode{\color{\markcolor{#1}}\rule[-1.6pt]{0.7pt}{9.6pt}\rule[7.3pt]{2.6pt}{0.7pt}}\kern1.2pt\relax}
\newcommand\EMK[2]{\kern1.2pt{\color{\markcolor{#1}}\rule[-1.6pt]{2.6pt}{0.7pt}\rule[-1.6pt]{0.7pt}{9.6pt}%
  \raisebox{5.6pt}{\notenum{#1}{#2}}}\relax}
\newcommand\notenum[2]{{\labelfont\bfseries\fontsize{7.2}{7.2}\selectfont\color{white}%
  \setlength\fboxsep{0.6pt}\colorbox{\markcolor{#1}}{\,#2\,}}}
\newcommand\yitag[1]{{\cjksans\bfseries\fontsize{8}{8}\selectfont\color{tealtext}译}\,\notenum{y}{#1}}
\newcommand\yufatag[1]{{\cjksans\bfseries\fontsize{8}{8}\selectfont\color{orange}语法}\,\notenum{g}{#1}}
\tcbset{notebox/.style={enhanced,breakable=false,boxrule=0pt,arc=0pt,outer arc=0pt,
  left=4.5pt,right=4.5pt,top=2.4pt,bottom=2.6pt,boxsep=0pt,before skip=2pt,after skip=5pt,
  leftrule=1.6pt}}
% \YI{num}{zh}
\newcommand\YI[2]{\par\begin{tcolorbox}[notebox,colback=yibg,colframe=tealtext]
  \setlength\baselineskip{12.4pt}\yitag{#1}\enspace{\kai\fontsize{8.8}{12.4}\selectfont\color{black!80}#2}
  \end{tcolorbox}}
% \GRAM{num}{items}{segments}; each item: \GITEM{title}{general line}{this sentence}
\newcommand\GITEM[3]{{\cjksans\bfseries\fontsize{8.6}{12.2}\selectfont\color{orange}#1}\enspace
  {\cjksans\fontsize{8.2}{12.2}\selectfont\color{black!80}#2\ifstrempty{#3}{}{\ {\color{black!66}#3}}}\par}
% \GTERMS{\GTERM{en}{ipa}{pos}{zh}\GTSEP ...}: grammar-metalanguage words taught in the note
\newcommand\GTERM[4]{{\fontsize{8.4}{12.2}\selectfont\color{black!85}#1}\,%
  \ifstrempty{#2}{}{{\ipafont\fontsize{7.6}{8}\selectfont\color{greytext}#2}\,}%
  {\labelfont\itshape\fontsize{7.6}{8}\selectfont\color{tealtext}#3}\,{\kai\fontsize{8.2}{8}\selectfont\color{tealtext}#4}}
\newcommand\GTSEP{{\kai\fontsize{8.2}{8}\selectfont\color{greytext}；}}
\newcommand\GTERMS[1]{{\cjksans\fontsize{8}{12.2}\selectfont\color{greytext}术语：}#1\par}
\newcommand\GRAM[3]{\par\begin{tcolorbox}[notebox,breakable,colback=gbg,colframe=orange,left=34pt]
  \setlength\baselineskip{12.2pt}\setlength\parskip{0.8pt}\raggedright%
  \noindent\llap{\raisebox{0.2pt}{\yufatag{#1}}\hspace{4pt}}#2%
  \ifstrempty{#3}{}{\vspace{1pt}{\setlength\baselineskip{22pt}\setlength\lineskiplimit{1pt}\setlength\lineskip{1.5pt}%
    \leftskip=0pt \raggedright #3\par}\vspace{-1pt}}
  \end{tcolorbox}}
\newcommand\SEG[3]{\cell{\ulsolid[#3]{\fontsize{9.4}{11}\selectfont #1}}{\annline{{\cjksans\fontsize{7.8}{8}\selectfont\color{#3}#2}}}\hskip 0.5em\relax}

% ---------- lesson header (compact band) ----------
% the header is typeset as a box first; the cream band behind it is then drawn to the box's real height,
% so long titles wrap and push the Chinese subtitle and the meta line down instead of overlapping them
\newsavebox\lhbox
\newlength\lhband \newlength\lhbandrule
\newcommand\lhbadge[1]{\begin{tikzpicture}[baseline={([yshift=-3.6mm]b.north)}]
  \node[fill=teal,rounded corners=2pt,minimum width=11.5mm,minimum height=11.5mm,text=white,align=center,inner sep=0pt](b)
    {\labelfont\fontsize{7.2}{7.4}\selectfont LESSON\\[0.4pt]{\labelfont\bfseries\fontsize{15}{16}\selectfont #1}};
  \end{tikzpicture}}
\newcommand\LessonHeader[6]{%
  \clearpage\label{lesson#1}\renewcommand\lessonfoot{#6}\thispagestyle{plain}\write-1{LESSONSTART #1 \thepage}%
  \setbox\lhbox\vbox{\hsize\textwidth\parindent0pt\kern1.5mm
    \hbox{\lhbadge{#1}\hspace{3mm}\vtop{\hsize\dimexpr\textwidth-14.5mm\relax\raggedright
      {\titlefont\fontsize{14}{16.8}\selectfont\color{black!88}#2\par}\vspace{2.5pt}%
      {\kai\fontsize{10.4}{13}\selectfont\color{tealtext}#3}\hfill\tikz[baseline=(g.base)]\node[draw=orange,rounded corners=2.5pt,inner sep=1.8pt,line width=0.5pt](g)
        {\fontsize{7.8}{8}\selectfont\color{orange}\strut#4};\par\vspace{2.5pt}%
      {\fontsize{7.8}{11}\selectfont\color{greytext}#5\par}}}}%
  \setlength\lhband{\dimexpr 11mm+\ht\lhbox+\dp\lhbox+2.6mm\relax}\setlength\lhbandrule{\dimexpr\lhband+0.7mm\relax}%
  \hbox{\begin{tikzpicture}[remember picture,overlay]
    \fill[cream] (current page.north west) rectangle ([yshift=-\lhband]current page.north east);
    \fill[teal] ([yshift=-\lhband]current page.north west) rectangle ([yshift=-\lhbandrule]current page.north east);
  \end{tikzpicture}\box\lhbox}%
  \vspace{6.5mm}\par}
\fancypagestyle{plain}{\setfooter}

% ---------- front-matter section band (contents, key, word lists) ----------
% title starts at the left text edge: inner margin on odd (recto) pages, outer on even
\newcommand\SectionBand[2]{\thispagestyle{empty}%
  \ifodd\value{page}\def\bandx{15mm}\else\def\bandx{11mm}\fi
  \begin{tikzpicture}[remember picture,overlay]
    \fill[cream] (current page.north west) rectangle ([yshift=-31mm]current page.north east);
    \fill[teal] ([yshift=-31mm]current page.north west) rectangle ([yshift=-31.7mm]current page.north east);
    \node[anchor=north west,inner sep=0pt] at ([xshift=\bandx,yshift=-11mm]current page.north west)
         {\cjksemi\fontsize{18}{22}\selectfont #1};
    \node[anchor=north west,inner sep=0pt] at ([xshift=\bandx,yshift=-21.5mm]current page.north west)
         {\labelfont\fontsize{8.6}{10}\selectfont\color{tealtext}#2};
  \end{tikzpicture}%
  \par\null\vspace{19mm}}

% ---------- self-test list ----------
\newcommand\cbox{\leavevmode{\color{greyline}$\square$}}
\newcommand\SelfTest[2]{\par\vspace{3pt}%
  \begin{tcolorbox}[enhanced,breakable,boxrule=0.5pt,colframe=greyline,colback=white,arc=2pt,left=5pt,right=5pt,top=2.5pt,bottom=2pt]
  {\cjksans\bfseries\fontsize{9.2}{11}\selectfont\color{tealtext}自测词表}\enspace
  {\labelfont\fontsize{8}{11}\selectfont\color{greytext}#1}\par\vspace{2pt}
  {\raggedright\fontsize{8.4}{11.0}\selectfont #2\par}
  \end{tcolorbox}}
\newcommand\TW[1]{\mbox{\cbox\,#1}\hspace{0.9em plus 0.6em minus 0.2em}\allowbreak}
\newcommand\sourceline[1]{\par\vspace{3pt}{\raggedright\labelfont\fontsize{7.6}{9.4}\selectfont\color{greytext}#1\par}}

\endinput
